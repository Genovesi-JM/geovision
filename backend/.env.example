# GeoVision backend environment template
#
# Copy this file to backend/.env for local development. The real .env file is
# ignored by Git. Keep credentials in the deployment platform's secret store
# for staging and production; never commit real values here.

# Runtime profile: local | dev | test | staging | prod
# ENVIRONMENT is accepted as a legacy alias for ENV; if both are set they must agree.
# Only the signing/encryption guards are checked at application startup. Most
# provider selection and credential checks happen when that provider is used.
ENV=local
APP_NAME=GeoVision Backend
APP_VERSION=1.0.0
PORT=8010
MIGRATE_TIMEOUT_SECONDS=120

# Public URLs and browser access
BACKEND_BASE=http://127.0.0.1:8010
FRONTEND_BASE=http://127.0.0.1:8001
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

# Authentication and encryption
# Local/dev/test generate an ephemeral JWT key while this remains CHANGE_ME.
# Staging/prod enforce only a minimum length/known-placeholder check, so supply
# a generated high-entropy SECRET_KEY. They also require a valid Fernet key.
# Back up ENCRYPTION_KEY securely and plan a verified re-encryption before
# rotating it; there is no key-ring or automatic rotation support.
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30
ADMIN_PASSWORD=

# Databases
DATABASE_URL=sqlite:///./geovision.db
ACCOUNTS_DATABASE_URL=sqlite:///./accounts.db

# Identity selection and optional OAuth credentials
# Phase 3 owns the full identity-provider adapter migration.
IDENTITY_PROVIDER=internal
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# GAIA AI explanation service. Without a key, the existing demo response is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shared integration policy
INTEGRATION_CONNECT_TIMEOUT_SECONDS=5
INTEGRATION_READ_TIMEOUT_SECONDS=30
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_INITIAL_SECONDS=0.5
INTEGRATION_RETRY_MAX_SECONDS=8

# Provider declarations. Object storage, ERP, and notifications currently drive
# factories. Identity and the none/null placeholder values below do not activate
# or disable a provider implementation in Phase 2.
QUEUE_PROVIDER=null
PROCESSING_PROVIDER=none
WEATHER_PROVIDER=none
SATELLITE_PROVIDER=none
GIS_PROVIDER=none
CONSTRUCTION_PROVIDER=none
ASSET_MANAGEMENT_PROVIDER=none
MARITIME_PROVIDER=none

# Object storage: current concrete adapter is S3-compatible. Supply both
# explicit access-key fields or neither; the SDK credential chain is used when
# both are blank. There is no local write fallback, and uploads are buffered in
# memory before transfer, so use a configured S3 endpoint/emulator for testing.
OBJECT_STORAGE_PROVIDER=s3
S3_BUCKET=geovision-datasets
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ERP: mock is allowed only in local/dev/test and is rejected when a deployed
# runtime resolves the adapter (not at application startup). New outbox jobs are
# pinned to their selected provider. Odoo is not implemented yet.
ERP_PROVIDER=mock
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Reserved for a future inbound ERPNext webhook flow; Phase 2 does not consume it.
ERPNEXT_WEBHOOK_SECRET=

# Notifications. auto selects SMTP when configured, or writes recipient and
# subject to backend/email_log.txt in local/dev/test. That file can contain PII,
# is permission-hardened and Git-ignored, but is not rotated. Deployed delivery
# requires STARTTLS with certificate verification; implicit SMTPS is not used.
NOTIFICATION_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Payments. Phase 8 owns lifecycle consolidation. Creation and webhook readiness
# are separate: Multicaixa creation needs merchant ID + API key, Stripe creation
# needs its secret key, and each deployed webhook also needs its webhook secret.
# PayPal deployed webhook verification and API refunds are not implemented.
MULTICAIXA_API_URL=https://api.multicaixa.co.ao/v1
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=
MULTICAIXA_WEBHOOK_SECRET=
MULTICAIXA_CALLBACK_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Built-in bank details remain for compatibility and are not validated as live.
# Override every applicable field with approved values before enabling transfers.
# COMPANY_IBAN=
# COMPANY_BIC=
# COMPANY_BANK_NAME=
# COMPANY_IBAN_INTL=
# COMPANY_BIC_INTL=
# COMPANY_BANK_INTL=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://127.0.0.1:8001/loja.html?paypal=success
PAYPAL_CANCEL_URL=http://127.0.0.1:8001/loja.html?paypal=cancel

# IoT/MQTT. Disabled by default; see ../.env.iot.example for the local stack.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=geovision
MQTT_CLIENT_ID=geovision-backend
IOT_MESSAGE_MAX_AGE_SECONDS=300
IOT_OFFLINE_AFTER_SECONDS=120
IOT_COMMAND_TTL_SECONDS=300
IOT_MAX_MESSAGES_PER_MINUTE=120
IOT_RAW_RETENTION_DAYS=30
IOT_AGGREGATE_RETENTION_DAYS=730
