# GeoVision backend environment template
#
# Copy this file to backend/.env for local development. The real .env file is
# ignored by Git. Keep credentials in the deployment platform's secret store
# for staging and production; never commit real values here.

# Runtime profile: local | dev | test | staging | prod
# ENVIRONMENT is accepted as a legacy alias for ENV; if both are set they must agree.
# Signing/encryption and structural identity configuration are checked at
# application startup. Most other provider credential checks happen on use.
ENV=local
APP_NAME=GeoVision Backend
APP_VERSION=1.0.0
PORT=8010
MIGRATE_TIMEOUT_SECONDS=120

# Public URLs and browser access. Staging/prod require dedicated absolute HTTPS
# URLs with no userinfo, query string, or fragment.
BACKEND_BASE=http://127.0.0.1:8010
FRONTEND_BASE=http://127.0.0.1:8001
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Comma-separated exact proxy IPs/CIDRs allowed to supply X-Forwarded-For.
# Leave blank unless the application is reachable only through those proxies.
TRUSTED_PROXY_CIDRS=

# Authentication and encryption
# Local/dev/test generate an ephemeral JWT key while this remains CHANGE_ME.
# Staging/prod enforce only a minimum length/known-placeholder check, so supply
# a generated high-entropy SECRET_KEY. They also require a valid Fernet key.
# Back up ENCRYPTION_KEY securely and plan a verified re-encryption before
# rotating it; there is no key-ring or automatic rotation support.
SECRET_KEY=CHANGE_ME
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
REFRESH_TOKEN_EXPIRES_DAYS=30
# Configure both admin values together. Deployed bootstrap passwords require
# at least 12 characters and at most 72 UTF-8 bytes.
ADMIN_PASSWORD=
ADMIN_EMAILS=
INTERNAL_TOKEN_ISSUER=geovision
INTERNAL_TOKEN_AUDIENCE=geovision-api
ACCEPT_LEGACY_ACCESS_TOKENS=true
EXTERNAL_IDENTITY_SESSION_MAX_HOURS=24

# Databases
DATABASE_URL=sqlite:///./geovision.db
ACCOUNTS_DATABASE_URL=sqlite:///./accounts.db

# Identity selection and optional OAuth credentials. Keep `internal` until the
# Entra values below are complete and the staged cutover runbook has passed.
# Internal GeoVision sessions remain the credential for business API routes in
# every mode. `transition` enables the dedicated external-token exchange while
# preserving the internal adapter; email auto-link remains off by default.
IDENTITY_PROVIDER=internal
IDENTITY_AUTO_LINK_VERIFIED_EMAIL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
ENTRA_EXTERNAL_ID_ISSUER=
ENTRA_EXTERNAL_ID_AUDIENCE=
ENTRA_EXTERNAL_ID_TENANT_ID=
# Optional: derived from the exact issuer when blank.
ENTRA_EXTERNAL_ID_DISCOVERY_URL=
ENTRA_EXTERNAL_ID_REQUIRED_SCOPE=access_as_user
ENTRA_EXTERNAL_ID_AUTHORIZED_PARTY=
ENTRA_EXTERNAL_ID_CLOCK_SKEW_SECONDS=60
ENTRA_EXTERNAL_ID_JWKS_CACHE_SECONDS=3600

# GAIA AI explanation service. Without a key, the existing demo response is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Report narrative defaults to the offline deterministic provider. Selecting
# azure_openai/openai currently exercises the explicit unavailable boundary and
# falls back safely until dedicated credentials/model access are approved.
REPORT_NARRATIVE_PROVIDER=deterministic
REPORT_NARRATIVE_MODEL=

# Shared integration policy
INTEGRATION_CONNECT_TIMEOUT_SECONDS=5
INTEGRATION_READ_TIMEOUT_SECONDS=30
INTEGRATION_RETRY_ATTEMPTS=3
INTEGRATION_RETRY_INITIAL_SECONDS=0.5
INTEGRATION_RETRY_MAX_SECONDS=8

# Provider declarations drive factories at application/worker composition
# boundaries. A `none`/`null` selection is explicitly unavailable rather than
# silently simulated.
QUEUE_PROVIDER=database
EVENT_TOPIC=geovision.domain.v1
# Keep false for API replicas. Run `python -m app.workers.event_worker` as a
# separate process; local single-process demos may explicitly opt in.
EVENT_WORKER_IN_PROCESS=false
EVENT_WORKER_POLL_SECONDS=1
EVENT_WORKER_BATCH_SIZE=50
EVENT_WORKER_MAX_ATTEMPTS=8
EVENT_WORKER_CLAIM_TIMEOUT_SECONDS=300
EVENT_RETRY_INITIAL_SECONDS=1
EVENT_RETRY_MAX_SECONDS=300

# Azure Service Bus is optional. Prefer workload/managed identity with a fully
# qualified namespace; the connection string is a compatibility secret.
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_TOPIC=geovision-events
SERVICE_BUS_SUBSCRIPTION=geovision-workers

# Azure Event Grid BlobCreated webhook bridge. Use a random 32+ character
# custom delivery header value in deployed environments.
AZURE_EVENT_GRID_ENABLED=false
AZURE_EVENT_GRID_WEBHOOK_SECRET=
AZURE_EVENT_GRID_SUBSCRIPTION_NAME=

# Azure IoT Hub telemetry arrives through an authenticated Event Grid webhook
# and is normalized into the same GeoVision envelope as REST/MQTT. Keep this
# disabled until Gate 13. The custom delivery secret must be random and 32+
# characters in staging/production; it is not an IoT Hub device credential.
IOT_CLOUD_PROVIDER=none
AZURE_IOT_HUB_ENABLED=false
AZURE_IOT_HUB_WEBHOOK_SECRET=
AZURE_IOT_HUB_NAME=

# Photogrammetry. `fake` is deterministic and local/test only. For a local
# end-to-end demo, select fake, enable automatic creation and run both the event
# worker and processing worker as separate processes. NodeODM credentials stay
# server-side; never put its token in dataset metadata or a client build.
PROCESSING_PROVIDER=none
PROCESSING_AUTO_CREATE_ENABLED=false
PROCESSING_DEFAULT_OUTPUTS=ORTHOMOSAIC,DSM,POINT_CLOUD
PROCESSING_WORKER_IN_PROCESS=false
PROCESSING_WORKER_POLL_SECONDS=5
PROCESSING_WORKER_BATCH_SIZE=5
PROCESSING_WORKER_CLAIM_TIMEOUT_SECONDS=1800
PROCESSING_DEFAULT_MAX_RETRIES=3
PROCESSING_RETRY_INITIAL_SECONDS=10
PROCESSING_RETRY_MAX_SECONDS=900
PROCESSING_MINIMUM_IMAGES=2
PROCESSING_MAX_INPUT_BYTES=1073741824
PROCESSING_MAX_OUTPUT_ARCHIVE_BYTES=1073741824
PROCESSING_MAX_OUTPUT_UNPACKED_BYTES=2147483648
PROCESSING_MAX_OUTPUT_FILES=500
PROCESSING_PROVIDER_READ_TIMEOUT_SECONDS=300
PROCESSING_PROVIDER_WRITE_TIMEOUT_SECONDS=3600
NODEODM_BASE_URL=
NODEODM_TOKEN=

# Satellite and weather intelligence. `fake` is deterministic and limited to
# local/dev/test. Copernicus scene metadata is available without a token for
# public catalogue searches; protected asset downloads may require a bearer
# token. AEMET requires a server-side OpenData key. Run the independent worker
# for scheduled acquisition; keep in-process execution to local demos only.
SATELLITE_PROVIDER=none
WEATHER_PROVIDER=none
INTELLIGENCE_WORKER_IN_PROCESS=false
INTELLIGENCE_WORKER_POLL_SECONDS=30
INTELLIGENCE_WORKER_BATCH_SIZE=10
INTELLIGENCE_WORKER_CLAIM_TIMEOUT_SECONDS=600
INTELLIGENCE_MAX_ATTEMPTS=3
INTELLIGENCE_RETRY_INITIAL_SECONDS=30
INTELLIGENCE_RETRY_MAX_SECONDS=3600
SATELLITE_CACHE_TTL_SECONDS=21600
WEATHER_CACHE_TTL_SECONDS=1800
SATELLITE_DEFAULT_COLLECTION=sentinel-2-l2a
SATELLITE_DEFAULT_LOOKBACK_DAYS=14
SATELLITE_DEFAULT_MAX_CLOUD_COVER_PERCENT=60
SATELLITE_MAX_SCENES_PER_REQUEST=20
SATELLITE_DOWNLOAD_ASSETS_ENABLED=false
SATELLITE_DOWNLOAD_ASSET_KEYS=thumbnail
SATELLITE_MAX_ASSET_BYTES=268435456
COPERNICUS_STAC_BASE_URL=https://stac.dataspace.copernicus.eu/v1
COPERNICUS_ACCESS_TOKEN=
COPERNICUS_ALLOWED_DOWNLOAD_HOSTS=download.dataspace.copernicus.eu,datahub.creodias.eu
WEATHER_DEFAULT_LOOKBACK_HOURS=12
AEMET_BASE_URL=https://opendata.aemet.es/opendata
AEMET_API_KEY=
AEMET_MAX_STATION_DISTANCE_KM=150

# Official MITECO GIS context is public and credential-free, but Spain-scoped.
# Select `miteco` only where the reviewed collection manifest is appropriate.
GIS_PROVIDER=none
LOCATION_PROVIDER=none
GOOGLE_MAPS_SERVER_API_KEY=
MITECO_OGC_FEATURES_BASE_URL=https://gis.miteco.gob.es/geoserver/ogc/features/v1
MITECO_GIS_MAX_FEATURES=100
MITECO_GIS_MAX_RESPONSE_BYTES=2097152
CONSTRUCTION_PROVIDER=none
# Asset management accepts none/null, local/test fake/deterministic, seequent,
# mine_enterprise, sap_eam, ibm_maximo, dynamics_365_asset_management, or
# customer_cmms. Named providers are fail-closed scaffolds only.
ASSET_MANAGEMENT_PROVIDER=none
# Maritime accepts none/null, local/test fake/deterministic, marinetraffic,
# kpler, or puertos_del_estado. Every named provider is fail closed: no live
# endpoint, credential, entitlement, redistribution, or safety use is implied.
MARITIME_PROVIDER=none

# Enterprise seams are disabled by default. `fake`/`deterministic` are
# local/test contract fixtures only. Autodesk APS, Procore, Bentley iTwin,
# Trimble, ArcGIS, and Seequent remain explicit unavailable scaffolds even when
# both credential fields are supplied; credentials alone never activate a
# connector. MITECO is the separate public official-data adapter and uses no
# credentials. Generic mine-enterprise, SAP EAM, IBM Maximo, Dynamics 365 Asset
# Management, customer CMMS, MarineTraffic, Kpler, and Puertos del Estado
# authentication/access settings are intentionally absent until an approved
# customer sandbox and the Phase 32 registry exist.
AUTODESK_APS_CLIENT_ID=
AUTODESK_APS_CLIENT_SECRET=
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
BENTLEY_ITWIN_CLIENT_ID=
BENTLEY_ITWIN_CLIENT_SECRET=
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
ARCGIS_CLIENT_ID=
ARCGIS_CLIENT_SECRET=
SEEQUENT_CLIENT_ID=
SEEQUENT_CLIENT_SECRET=

# Object storage: local streams to a private filesystem root for development.
# Use azure_blob in Azure deployments or s3 for an S3-compatible service.
# GeoVision stores only object references in PostgreSQL; never expose account
# keys to browsers or mobile clients.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./data/object-storage
DATASET_DIRECT_UPLOAD_MAX_BYTES=524288000
DATASET_SIGNED_UPLOAD_MAX_BYTES=4294967296
DATASET_SIGNED_URL_EXPIRY_SECONDS=900

# Azure Blob Storage. Prefer a managed identity with AZURE_STORAGE_ACCOUNT_URL;
# an account key is needed only when this API itself must mint account-key SAS.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=geovision-datasets
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_MANAGED_IDENTITY_CLIENT_ID=

# S3-compatible compatibility adapter. Supply both explicit access-key fields
# or neither; the SDK credential chain is used when both are blank.
S3_BUCKET=geovision-datasets
S3_REGION=eu-west-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ERP: mock is allowed only in local/dev/test and is rejected when a deployed
# runtime resolves the adapter. New outbox jobs remain pinned to their selected
# provider through cutover and rollback. Odoo 19 uses JSON-2 through one bridge.
ERP_PROVIDER=mock
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Reserved; ERPNext inbound callbacks are not implemented.
ERPNEXT_WEBHOOK_SECRET=
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_API_KEY=
ODOO_WEBHOOK_SECRET=
ODOO_BRIDGE_MODEL=geovision.integration.bridge
ODOO_BRIDGE_METHOD=sync_from_geovision
ERP_WORKER_POLL_SECONDS=5
ERP_WORKER_BATCH_SIZE=50
ERP_WORKER_CLAIM_TIMEOUT_SECONDS=300
ERP_CALLBACK_REPLAY_WINDOW_SECONDS=300

# Notifications. auto selects SMTP when configured. In local/dev/test, durable
# delivery writes IDs/channel only to backend/notification_delivery_log.txt;
# the legacy direct-email compatibility path still uses backend/email_log.txt
# and may contain PII. Both files are permission-hardened and Git-ignored but
# are not rotated. Deployed SMTP requires STARTTLS with certificate verification;
# implicit SMTPS is not used.
NOTIFICATION_PROVIDER=auto
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_CLAIM_TIMEOUT_SECONDS=300
NOTIFICATION_WORKER_RETRY_BASE_SECONDS=30
NOTIFICATION_WORKER_RETRY_MAX_SECONDS=3600
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10
# Push delivery uses Azure Notification Hubs installations. Mobile payloads
# contain only a notification ID; the authorized API resolves the target.
AZURE_NOTIFICATION_HUBS_NAMESPACE=
AZURE_NOTIFICATION_HUBS_HUB_NAME=
AZURE_NOTIFICATION_HUBS_SAS_KEY_NAME=
AZURE_NOTIFICATION_HUBS_SAS_KEY=

# Payments. Phase 8 owns lifecycle consolidation. Creation and webhook readiness
# are separate: Multicaixa creation needs merchant ID + API key, Stripe creation
# needs its secret key, and each deployed webhook also needs its webhook secret.
# PayPal deployed webhook verification and API refunds are not implemented.
MULTICAIXA_API_URL=https://api.multicaixa.co.ao/v1
MULTICAIXA_MERCHANT_ID=
MULTICAIXA_API_KEY=
MULTICAIXA_WEBHOOK_SECRET=
MULTICAIXA_CALLBACK_URL=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Built-in bank details remain for compatibility and are not validated as live.
# Override every applicable field with approved values before enabling transfers.
# COMPANY_IBAN=
# COMPANY_BIC=
# COMPANY_BANK_NAME=
# COMPANY_IBAN_INTL=
# COMPANY_BIC_INTL=
# COMPANY_BANK_INTL=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_RETURN_URL=http://127.0.0.1:8001/loja.html?paypal=success
PAYPAL_CANCEL_URL=http://127.0.0.1:8001/loja.html?paypal=cancel

# IoT/MQTT. Disabled by default; see ../.env.iot.example for the local stack.
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=geovision
MQTT_CLIENT_ID=geovision-backend
# Run `python -m app.workers.iot_worker` independently. Enable this only for a
# local single-process demo, never on horizontally scaled API replicas.
IOT_WATCHDOG_IN_PROCESS=false
IOT_WATCHDOG_INTERVAL_SECONDS=30
IOT_MESSAGE_MAX_AGE_SECONDS=300
IOT_OFFLINE_AFTER_SECONDS=120
IOT_COMMAND_TTL_SECONDS=300
IOT_MAX_MESSAGES_PER_MINUTE=120
IOT_RAW_RETENTION_DAYS=30
IOT_AGGREGATE_RETENTION_DAYS=730
# Oldest signed FieldBox/ESP32 queued measurement accepted after reconnection.
# It cannot exceed raw retention.
IOT_STORE_FORWARD_MAX_AGE_DAYS=30
